# Application
APP_NAME="Booking Engine & AI Agent API"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database (Asyncpg for app, psycopg2 for sync migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=booking_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/booking_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/booking_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI / LLM Configuration
LLM_PROVIDER=openai  # options: openai, gemini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Distributed Lock & Booking Settings
LOCK_TIMEOUT_SECONDS=10
BOOKING_HOLD_EXPIRY_MINUTES=10

